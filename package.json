{
  "name": "Pebblegram",
  "author": "Bolger Innovations",
  "version": "3.6.0",
  "keywords": [
    "pebble-app"
  ],
  "scripts": {
    "build:pgjs-gramjs": "node tools/build-pgjs-gramjs.mjs",
    "build:emoji": "node tools/build-emoji-data.mjs"
  },
  "pebble": {
    "displayName": "Pebblegram",
    "uuid": "2430a9d0-5be9-4850-b259-821030705e46",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "capabilities": [
      "configurable"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Command",
      "Type",
      "Index",
      "Count",
      "ChatId",
      "MessageId",
      "ReplyTo",
      "Sender",
      "Text",
      "IsOutgoing",
      "IsUnread",
      "UnreadCount",
      "BridgeUrl",
      "CannedReplies",
      "Status",
      "Error",
      "ImageToken",
      "ImageData",
      "ImageSize",
      "ImageTransferId",
      "ImageWidth",
      "ImageHeight",
      "Reactions",
      "EditMessageId",
      "ReplySender",
      "ReplyText",
      "ForwardSender",
      "ForwardText",
      "MessageMeta"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "bitmap",
          "name": "IMAGE_WALLPAPER",
          "file": "images/wallpaper.png",
          "targetPlatforms": [
            "basalt",
            "emery",
            "gabbro"
          ]
        },
        {
          "type": "bitmap",
          "name": "IMAGE_TINT_SELECT",
          "file": "images/tint_select.png",
          "targetPlatforms": [
            "basalt",
            "emery",
            "gabbro"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "emojibase-data": "^17.0.0",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "js-sha1": "0.7.0",
    "js-sha256": "0.11.1",
    "telegram": "2.26.22",
    "upng-js": "2.1.0"
  }
}
